// Cloudflare Workers: serve the built static site (no server code).
// public/_redirects and public/_headers replace .htaccess there.
{
	"name": "anixi-apartments-website",
	"compatibility_date": "2026-10-13",
	"assets": {
		"directory": "./dist",
		"not_found_handling": "404-page",
		"html_handling": "force-trailing-slash"
	}
}
