---
import { settings } from '../lib/data';
import { t, href, ui, type Lang } from '../lib/i18n';
import { telHref } from '../lib/data';

interface Props { lang: Lang }
const { lang } = Astro.props;
const h = (p: string) => href(p, lang);
const year = new Date().getFullYear();
---
<footer class="site-footer">
  <div class="wrap">
    <div class="footer-grid">
      <div>
        <h4>{ui('menu', lang)}</h4>
        <ul>
          <li><a href={h('/')}>{ui('home', lang)}</a></li>
          <li><a href={h('/accommodations-2/')}>{ui('rooms', lang)}</a></li>
          <li><a href={h('/about/')}>{ui('about', lang)}</a></li>
          <li><a href={h('/prices/')}>{ui('prices', lang)}</a></li>
          <li><a href={h('/offers/')}>{ui('offers', lang)}</a></li>
          <li><a href={h('/contact/')}>{ui('contact', lang)}</a></li>
        </ul>
      </div>
      <div class="footer-contact">
        <img src="/favicon.png" alt="" width="60" height="60" />
        <p>{ui('address', lang)}: {t(settings.address, lang)}</p>
        <p>{ui('phone', lang)}:
          {settings.phones.map((p, i) => (<>{i > 0 && ', '}<a href={telHref(p.number)}>{p.number}</a></>))}
        </p>
        <p>{ui('email', lang)}:
          {settings.emails.map((e, i) => (<>{i > 0 && ', '}<a href={`mailto:${e}`}>{e}</a></>))}
        </p>
        {settings.facebook && <p><a href={settings.facebook} rel="noopener" target="_blank">Facebook</a></p>}
      </div>
      <div class="footer-map">
        {settings.map_embed && <iframe src={settings.map_embed} loading="lazy" title="Map" referrerpolicy="no-referrer-when-downgrade"></iframe>}
      </div>
    </div>
    <div class="footer-bottom">
      <p>© {year} Anixi Studios &amp; Apartments. {ui('rights', lang)}<br />{settings.license}</p>
      <p><a href={h('/privacy-policy-2/')}>{ui('privacy', lang)}</a></p>
      <!-- Default Statcounter code for Anixi Apartments http://www.anixi-apartments.gr -->
      <div class="statcounter-box">
        <script is:inline type="text/javascript">
          var sc_project=1291011;
          var sc_invisible=1;
          var sc_security="ef4c8043";
          var scJsHost = "https://";
          document.write("<sc"+"ript type='text/javascript' src='" + scJsHost + "statcounter.com/counter/counter.js'></"+"script>");
        </script>
        <noscript><div class="statcounter"><a title="Web Analytics Made Easy - Statcounter" href="https://statcounter.com/" target="_blank"><img class="statcounter" src="https://c.statcounter.com/1291011/0/ef4c8043/1/" alt="Web Analytics Made Easy - Statcounter" referrerpolicy="no-referrer-when-downgrade" /></a></div></noscript>
      </div>
      <!-- End of Statcounter Code -->
      {settings.eu_banner && (
        <a class="eu" href={settings.eu_pdf} target="_blank" rel="noopener"><img src={settings.eu_banner} alt="EU – ΕΣΠΑ 2014-2020" width="600" height="80" loading="lazy" /></a>
      )}
    </div>
  </div>
</footer>
