---
/**
 * Availability request form.
 * With a Web3Forms access key (CMS → Επικοινωνία & ρυθμίσεις → advanced) the request is delivered straight
 * to the booking e-mail. Without a key, or if the service is unreachable, it falls back to opening the
 * guest's own e-mail program with the message ready.
 */
import { settings, rooms } from '../lib/data';
import { t, ui, href, type Lang } from '../lib/i18n';

interface Props { lang: Lang }
const { lang } = Astro.props;
const key = (settings as { form_key?: string }).form_key?.trim() || '';
const msgs = {
  ok: ui('reqSent', lang), err: ui('reqError', lang), sending: ui('reqSending', lang),
  nights: ui('reqNights', lang), adults: ui('adults', lang), children: ui('children', lang), dates: ui('reqDatesInvalid', lang), subject: ui('reqSubject', lang),
};
---
<form class="enquiry request" data-key={key} data-to={settings.booking_email} data-lang={lang} data-msgs={JSON.stringify(msgs)}>
  <div class="row">
    <label><span>{ui('arrival', lang)} *</span><input name="arrival" type="date" required /></label>
    <label><span>{ui('departure', lang)} *</span><input name="departure" type="date" required /></label>
  </div>
  <p class="nights" aria-live="polite"></p>
  <div class="row">
    <label><span>{ui('adults', lang)} *</span>
      <select name="adults" required>{[1, 2, 3, 4, 5, 6].map((n) => <option value={n} selected={n === 2}>{n}</option>)}</select>
    </label>
    <label><span>{ui('children', lang)}</span>
      <select name="children">{[0, 1, 2, 3, 4].map((n) => <option value={n}>{n}</option>)}</select>
    </label>
  </div>
  <label><span>{ui('roomPref', lang)}</span>
    <select name="room">
      <option value="">{ui('anyRoom', lang)}</option>
      {rooms.map((r) => <option value={t(r.name, lang)} data-slug={r.slug}>{t(r.name, lang)} – {ui('upToGuests', lang, { n: r.guests })}</option>)}
    </select>
  </label>
  <div class="row">
    <label><span>{ui('name', lang)} *</span><input name="name" required autocomplete="name" /></label>
    <label><span>{ui('email', lang)} *</span><input name="email" type="email" required autocomplete="email" /></label>
  </div>
  <label><span>{ui('phoneOptional', lang)}</span><input name="phone" type="tel" autocomplete="tel" /></label>
  <label><span>{ui('message', lang)}</span><textarea name="message"></textarea></label>
  <input type="checkbox" name="botcheck" class="hp" tabindex="-1" autocomplete="off" aria-hidden="true" />
  <div><button class="btn btn-sand" type="submit">{ui('reqSend', lang)}</button></div>
  <p class="hint">{key ? ui('reqNote', lang) : ui('formNote', lang)} <a href={href('/privacy-policy-2/', lang)}>{ui('privacy', lang)}</a></p>
  <p class="status" role="status" aria-live="polite" hidden></p>
</form>

<script>
  const fmt = (v: string) => (v ? v.split('-').reverse().join('/') : '');
  const iso = (d: Date) => new Date(d.getTime() - d.getTimezoneOffset() * 6e4).toISOString().slice(0, 10);

  document.querySelectorAll<HTMLFormElement>('form.request').forEach((f) => {
    const m = JSON.parse(f.dataset.msgs || '{}');
    const arr = f.elements.namedItem('arrival') as HTMLInputElement;
    const dep = f.elements.namedItem('departure') as HTMLInputElement;
    const nightsEl = f.querySelector<HTMLElement>('.nights')!;
    const status = f.querySelector<HTMLElement>('.status')!;
    const btn = f.querySelector<HTMLButtonElement>('button[type=submit]')!;

    // No past dates; departure at least one night after arrival.
    const today = new Date();
    arr.min = iso(today);
    dep.min = iso(new Date(today.getTime() + 864e5));
    const nights = () => (arr.value && dep.value ? Math.round((Date.parse(dep.value) - Date.parse(arr.value)) / 864e5) : 0);
    const update = () => {
      if (arr.value) {
        const next = iso(new Date(Date.parse(arr.value) + 864e5));
        dep.min = next;
        if (!dep.value || dep.value < next) dep.value = iso(new Date(Date.parse(arr.value) + 7 * 864e5));
      }
      const n = nights();
      nightsEl.textContent = n > 0 ? m.nights.replace('{n}', n) : '';
    };
    arr.addEventListener('change', update);
    dep.addEventListener('change', update);

    // Coming from a "Book" button: make sure the form is in view (the browser's own jump is unreliable on slow loads).
    if (location.hash === '#request') addEventListener('load', () => document.getElementById('request')?.scrollIntoView());

    // ?room=room-11 (from a room page) preselects that room.
    const slug = new URLSearchParams(location.search).get('room');
    if (slug) {
      const opt = f.querySelector<HTMLOptionElement>(`option[data-slug="${CSS.escape(slug)}"]`);
      if (opt) opt.selected = true;
    }

    const show = (text: string, ok = false) => {
      status.hidden = false;
      status.className = 'status ' + (ok ? 'ok' : 'err');
      status.textContent = text;
    };

    f.addEventListener('submit', async (e) => {
      e.preventDefault();
      const n = nights();
      if (n < 1) { show(m.dates); dep.focus(); return; }
      const d = new FormData(f);
      if (d.get('botcheck')) return;
      const g = (k: string) => String(d.get(k) || '').trim();
      const guests = `${g('adults')} ${m.adults}${g('children') !== '0' ? ` + ${g('children')} ${m.children}` : ''}`;
      const subject = `${m.subject}: ${fmt(g('arrival'))} – ${fmt(g('departure'))}, ${guests} – ${g('name')}`;
      const fields: [string, string][] = [
        ['Name', g('name')], ['Email', g('email')], ['Phone', g('phone')],
        ['Arrival', fmt(g('arrival'))], ['Departure', fmt(g('departure'))], ['Nights', String(n)],
        ['Adults', g('adults')], ['Children', g('children')], ['Room', g('room') || '-'],
        ['Language', f.dataset.lang === 'el' ? 'Ελληνικά' : 'English'], ['Message', g('message')],
      ];
      const body = fields.filter(([, v]) => v).map(([k, v]) => `${k}: ${v}`).join('\n');
      const mailto = `mailto:${f.dataset.to}?subject=${encodeURIComponent(subject)}&body=${encodeURIComponent(body)}`;

      if (!f.dataset.key) { location.href = mailto; return; }

      btn.disabled = true;
      show(m.sending, true);
      try {
        const res = await fetch('https://api.web3forms.com/submit', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json', Accept: 'application/json' },
          body: JSON.stringify({
            access_key: f.dataset.key, subject, from_name: 'anixi-apartments.gr', replyto: g('email'),
            ...Object.fromEntries(fields.filter(([, v]) => v)),
          }),
        });
        const json = await res.json().catch(() => ({}));
        if (!res.ok || !json.success) throw new Error(json.message || res.status);
        f.reset();
        nightsEl.textContent = '';
        show(m.ok, true);
      } catch {
        status.hidden = false;
        status.className = 'status err';
        status.textContent = m.err + ' ';
        const a = document.createElement('a');
        a.href = mailto;
        a.textContent = f.dataset.to || '';
        status.append(a);
      } finally {
        btn.disabled = false;
      }
    });
  });
</script>
