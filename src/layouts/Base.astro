---
import '../styles/global.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import Lightbox from '../components/Lightbox.astro';
import Icon from '../components/Icon.astro';
import { settings } from '../lib/data';
import { t, type Lang } from '../lib/i18n';

interface Props {
  lang: Lang;
  title: string;
  description?: string;
  path: string;          // language-neutral path, e.g. '/about/'
  image?: string;
  noindex?: boolean;
}
const { lang, title, description = '', path, image, noindex } = Astro.props;
const site = Astro.site!.origin;
const fullTitle = path === '/' ? `${settings.name} – ${t(settings.tagline, lang)}` : `${title} – ${settings.name}`;
const enUrl = site + path;
const elUrl = site + '/el' + path;
---
<!doctype html>
<html lang={lang}>
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <title>{fullTitle}</title>
  {description && <meta name="description" content={description} />}
  {(noindex || process.env.PREVIEW === "1") && <meta name="robots" content="noindex, nofollow" />}
  <link rel="canonical" href={lang === 'el' ? elUrl : enUrl} />
  <link rel="alternate" hreflang="en" href={enUrl} />
  <link rel="alternate" hreflang="el" href={elUrl} />
  <link rel="alternate" hreflang="x-default" href={enUrl} />
  <meta property="og:title" content={fullTitle} />
  <meta property="og:type" content="website" />
  <meta property="og:url" content={lang === 'el' ? elUrl : enUrl} />
  {image && <meta property="og:image" content={site + image} />}
  {description && <meta property="og:description" content={description} />}
  <link rel="icon" href="/favicon.png" />
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link href="https://fonts.googleapis.com/css2?family=Open+Sans:wght@300;400;600&display=swap&subset=greek" rel="stylesheet" />
  <script type="application/ld+json" set:html={JSON.stringify({
    '@context': 'https://schema.org', '@type': 'LodgingBusiness', name: settings.name,
    url: site + '/', telephone: settings.phones[0]?.number, email: settings.booking_email,
    address: { '@type': 'PostalAddress', addressLocality: 'Sisi', addressRegion: 'Crete', postalCode: '72400', addressCountry: 'GR' },
  })} />
</head>
<body>
  <Header lang={lang} path={path} />
  <main id="main">
    <slot />
  </main>
  <Footer lang={lang} />
  <Lightbox lang={lang} />
  <a href="#" class="back-top" aria-label="Top"><Icon name="up" /></a>
  <script>
    const b = document.querySelector('.back-top');
    addEventListener('scroll', () => b?.classList.toggle('show', scrollY > 600), { passive: true });
  </script>
</body>
</html>
